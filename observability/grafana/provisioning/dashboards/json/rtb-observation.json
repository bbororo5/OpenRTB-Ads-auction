{
  "uid": "rtb-observation",
  "title": "RTB — SSP / DSP observation",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1, "type": "text", "title": "How to read this screen",
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 3},
      "options": {"mode": "markdown", "content": "1. Confirm five scrape targets are UP. 2. Compare SSP and DSP HTTP status trends during the approved trial. 3. Compare CPU and JVM memory. **HTTP 200 is not proof that our DSP keeps bidding.** No HTTP data before the first request can be normal; do not interpret missing data as zero. Server latency here is not the end-to-end k6 SLO."}
    },
    {
      "id": 2, "type": "stat", "title": "Collector scrape status — 1 = UP",
      "gridPos": {"x": 0, "y": 3, "w": 24, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "up{job=\"stage8c-hosts\"}", "legendFormat": "{{node_role}}", "instant": true}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none"},
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []}
    },
    {
      "id": 3, "type": "timeseries", "title": "SSP inbound HTTP responses / second",
      "gridPos": {"x": 0, "y": 7, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (http_response_status_code, http_status_code) (rate({__name__=~\"http_server_request_duration_seconds_count|http_server_duration_milliseconds_count\",service_name=\"rtb-ssp\"}[1m]))", "legendFormat": "HTTP {{http_response_status_code}}{{http_status_code}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []}
    },
    {
      "id": 4, "type": "timeseries", "title": "DSP inbound HTTP responses / second — watch 204",
      "gridPos": {"x": 12, "y": 7, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (http_response_status_code, http_status_code) (rate({__name__=~\"http_server_request_duration_seconds_count|http_server_duration_milliseconds_count\",service_name=\"rtb-dsp\"}[1m]))", "legendFormat": "HTTP {{http_response_status_code}}{{http_status_code}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []}
    },
    {
      "id": 5, "type": "timeseries", "title": "Host CPU usage — cores (not percent)",
      "gridPos": {"x": 0, "y": 15, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (node_role) (rate(system_cpu_time_seconds_total{state!=\"idle\"}[1m]))", "legendFormat": "{{node_role}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []}
    },
    {
      "id": 6, "type": "timeseries", "title": "SSP / DSP JVM memory used",
      "gridPos": {"x": 12, "y": 15, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (service_name) (jvm_memory_used_bytes{service_name=~\"rtb-ssp|rtb-dsp\"})", "legendFormat": "{{service_name}}"}],
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}, "overrides": []}
    }
  ]
}
